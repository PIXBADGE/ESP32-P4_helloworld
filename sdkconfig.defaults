# AKS8 (ESP32-P4) 工程默认配置
# 基于微雪 02_HelloWorld 的 sdkconfig.defaults 调整

CONFIG_IDF_TARGET="esp32p4"

# ESP32-P4 Rev3.x（AKS8 硬件按较新芯片版本设计）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# bootloader 日志提到 INFO，便于定位启动阶段问题（发现问题后可改回 WARN）
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL=3

# 日志口 = UART0 -> ESP32-P4-ETH 开发板 Type-C 口（板载 CH343 USB 转串口），115200。
# 不要开 USB CDC / USB Serial/JTAG：那会把日志引到 OTG 口，Type-C 口反而没输出。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# ESP32-P4-ETH 开发板板载 32MB Nor Flash（AKS8 裸板为 16MB）
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 打印验证版不依赖 PSRAM，必须关闭：
# ESP32-P4 的 PSRAM 在 200MHz 下 DQS 校准可能失败，卡在初始化导致
# CHIP_WDT_RESET 无限重启且无任何日志。关掉后 bootloader 不再初始化 PSRAM。
# 恢复点屏版（AKS8_ENABLE_LCD=1）时若帧缓冲需要，再按需开启并降速到 80MHz 验证。
CONFIG_SPIRAM=n
CONFIG_SPIRAM_XIP_FROM_PSRAM=n

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# 主任务栈加大，便于调试
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# MIPI DSI 已内置于 esp_lcd，选中 esp32p4 target 后自动启用
# （SOC_MIPI_DSI_SUPPORTED = y），无需手动开启。
CONFIG_LCD_ENABLE_DEBUG_LOG=n
