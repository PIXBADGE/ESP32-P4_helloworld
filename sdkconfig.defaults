# AKS8 (ESP32-P4) 工程默认配置
# 基于微雪 02_HelloWorld 的 sdkconfig.defaults 调整

CONFIG_IDF_TARGET="esp32p4"

# ESP32-P4 Rev3.x（AKS8 硬件按较新芯片版本设计）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# 日志口使用 UART0。ESP32-P4 默认 UART0 TX=GPIO37、RX=GPIO38，波特率 115200。
# AKS8 的 USB-C 接在 USB-OTG 上，只用于 ROM 下载；app 运行日志不从这个口输出。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 16MB Flash 下 PSRAM 以 XIP 方式运行，屏幕显存/帧缓冲可用
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# 主任务栈加大，便于调试
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# MIPI DSI 已内置于 esp_lcd，选中 esp32p4 target 后自动启用
# （SOC_MIPI_DSI_SUPPORTED = y），无需手动开启。
CONFIG_LCD_ENABLE_DEBUG_LOG=n
